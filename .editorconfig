root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{java,groovy,gradle,kt,kts}]
indent_size = 4

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab

[gradlew]
indent_style = space
indent_size = 4

[gradlew.bat]
end_of_line = crlf
